# Server-side only. Never prefix these with VITE_.
PORTAL_URL=https://gh.space.gov.rw/portal
# Optional. Defaults to PORTAL_URL with /portal replaced by /server.
SERVER_URL=

# Signs the session cookie. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-this-in-production

# Optional. If the GIS team registers this app on GeoHub, sign-in uses the
# OAuth password grant; without them it uses generateToken.
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=

# Optional. Where the parcels, observations and index guide are read from:
#   referenced  the GIS team's WatchedParcels, ParcelObservations and IndexGuide
#               services, which the analysis notebook writes to (default)
#   hosted      the notebook's earlier RW_CropHealth_V2_View. Only if the GIS
#               team sets the notebook back to the hosted service.
DATA_SOURCE=

# Optional. The GIS team's "Analyse UPI" task (Notebook Server GP service).
# Defaults to the ParcelIndices task on gh.space.gov.rw.
ANALYSIS_URL=

# Optional. Port for `npm start`. Defaults to 4173.
PORT=
